---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { marked } from 'marked';

marked.setOptions({ gfm: true, breaks: false });

const programs = (await getCollection('programs'))
  .sort((a, b) => a.data.order - b.data.order);

const rendered = programs.map((p) => ({
  program: p,
  html: marked.parse(p.data.bodyHe ?? ''),
}));

const pageTitle = 'לימודים | מרכז AI';
const pageDescription =
  'שלוש תוכניות לתואר ראשון בבינה מלאכותית באוניברסיטה העברית: מסלול ההדגש ב-AI במדעי המחשב, תוכנית מט"ר במפגש של טכנולוגיה וחברה, ומסלול חד-חוגי במדעי המחשב וביולוגיה חישובית. בנוי לסטודנטים שרוצים להבין באמת איך מערכות AI עובדות.';

const programLd = programs.map((p) => ({
  '@context': 'https://schema.org',
  '@type': 'EducationalOccupationalProgram',
  name: p.data.nameHe,
  alternateName: p.data.name,
  description: p.data.seoDescriptionHe,
  url: `https://huji-ai-hub.pages.dev/he/academics#${p.data.slug}`,
  educationalProgramMode: 'full-time',
  occupationalCategory: 'Computer Science / Artificial Intelligence',
  programType: p.data.type,
  educationalCredentialAwarded: p.data.degreeLevel === 'bsc' ? "Bachelor's degree" :
                                 p.data.degreeLevel === 'msc' ? "Master's degree" :
                                 p.data.degreeLevel === 'phd' ? "Doctoral degree" :
                                 'Multiple degree levels',
  inLanguage: 'he',
  provider: {
    '@type': 'CollegeOrUniversity',
    name: 'האוניברסיטה העברית בירושלים',
    sameAs: 'https://new.huji.ac.il',
  },
  ...(p.data.officialWebsite ? { sameAs: p.data.officialWebsite } : {}),
}));
---

<Base title={pageTitle} lang="he" description={pageDescription}>
  {programLd.map((ld) => (
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  ))}

  <section class="hero-banner" style="background-image: url('/images/pexels-cottonbro-6153739.jpg');">
    <div class="hero-overlay"></div>
  </section>

  <section class="hero-text">
    <div class="container">
      <div class="hero-split">
        <h1>תוכניות לימוד בבינה מלאכותית</h1>
        <p>
          הבינה המלאכותית נולדה במדעי המחשב, אך כיום כלי ה-AI אינם נשארים במעבדה. הם
          מעצבים מחדש את כל תחומי המדע, ומשנים מן היסוד גם את מדעי המחשב עצמם. הקשר בין
          פיתוח טכנולוגיה חכמה לבין היישום שלה מעולם לא היה הדוק יותר. בדיוק מכאן,
          האוניברסיטה מציעה כיום ספקטרום רחב של תוכניות לימוד המכסות את המהפכה הזו במגוון
          תחומים, החל מלימודי AI בשילוב עם מדעי המחשב ועד לשילובם עם מדעי החברה דרך מדעי
          החיים ולימודי הקוגניציה.
        </p>
      </div>
    </div>
  </section>

  <section class="programs">
    <div class="container">
      <nav class="program-cards" aria-label="מסלולי לימוד ב-AI">
        {programs.map((p, i) => (
          <button
            type="button"
            class={`program-card ${i === 0 ? 'card-active' : ''}`}
            data-tab={p.data.slug}
            aria-controls={`panel-${p.data.slug}`}
            aria-selected={i === 0 ? 'true' : 'false'}
          >
            {p.data.image && (
              <div class="card-img" style={`background-image: url('${p.data.image}');`}></div>
            )}
            <div class="card-content">
              <h3 class="card-name">{p.data.nameHe}</h3>
              <p class="card-tagline">{p.data.taglineHe}</p>
            </div>
          </button>
        ))}
      </nav>

      <div class="panels">
        {rendered.map(({ program: p, html }, i) => (
          <article
            id={`panel-${p.data.slug}`}
            data-panel={p.data.slug}
            class={`panel ${i === 0 ? 'panel-visible' : ''}`}
            aria-hidden={i === 0 ? 'false' : 'true'}
          >
            <header class="panel-header">
              <p class="panel-eyebrow">
                {p.data.degreeLevel === 'bsc' ? 'תואר ראשון' :
                 p.data.degreeLevel === 'msc' ? 'תואר שני' :
                 p.data.degreeLevel === 'phd' ? 'תואר שלישי' :
                 'תוכנית רב-תארית'}
                {p.data.facultyHe && <span class="panel-faculty"> · {p.data.facultyHe}</span>}
              </p>
              <h2>{p.data.nameHe}</h2>
              <p class="panel-tagline">{p.data.taglineHe}</p>
            </header>

            {p.data.highlights && p.data.highlights.length > 0 && (
              <ul class="highlights" aria-label="עובדות על התוכנית">
                {p.data.highlights.map((h) => (
                  <li class="highlight-chip">
                    <span class="highlight-label">{h.labelHe ?? h.label}</span>
                    <span class="highlight-value">{h.valueHe ?? h.value}</span>
                  </li>
                ))}
              </ul>
            )}

            <div class="panel-body" set:html={html} />

            {(p.data.whoItsForHe || p.data.whatComesAfterHe) && (
              <div class="callout-grid">
                {p.data.whoItsForHe && (
                  <div class="callout">
                    <h3 class="callout-title">למי זה מתאים</h3>
                    <p>{p.data.whoItsForHe}</p>
                  </div>
                )}
                {p.data.whatComesAfterHe && (
                  <div class="callout">
                    <h3 class="callout-title">מה אחרי</h3>
                    <p>{p.data.whatComesAfterHe}</p>
                  </div>
                )}
              </div>
            )}

            <footer class="panel-footer">
              {p.data.officialWebsite && (
                <a href={p.data.officialWebsite} target="_blank" rel="noopener" class="cta-button">
                  אתר התוכנית הרשמי ↗
                </a>
              )}
              {p.data.courseListUrl && (
                <a href={p.data.courseListUrl} target="_blank" rel="noopener" class="cta-link">
                  רשימת קורסים מלאה ↗
                </a>
              )}
              {p.data.structurePdfUrl && (
                <a href={p.data.structurePdfUrl} target="_blank" rel="noopener" class="cta-link">
                  מבנה התוכנית (PDF) ↗
                </a>
              )}
              {p.data.registrationUrl && p.data.registrationUrl !== p.data.officialWebsite && (
                <a href={p.data.registrationUrl} target="_blank" rel="noopener" class="cta-link">
                  הרשמה ↗
                </a>
              )}
            </footer>
          </article>
        ))}
      </div>
    </div>
  </section>
</Base>

<script>
  function showPanel(slug, opts = { updateHash: true }) {
    document.querySelectorAll('.program-card').forEach((card) => {
      const isActive = card.getAttribute('data-tab') === slug;
      card.classList.toggle('card-active', isActive);
      card.setAttribute('aria-selected', isActive ? 'true' : 'false');
    });
    document.querySelectorAll('.panel').forEach((panel) => {
      const isActive = panel.getAttribute('data-panel') === slug;
      panel.classList.toggle('panel-visible', isActive);
      panel.setAttribute('aria-hidden', isActive ? 'false' : 'true');
    });
    if (opts.updateHash && window.location.hash !== `#${slug}`) {
      history.replaceState(null, '', `#${slug}`);
    }
  }

  function init() {
    document.querySelectorAll('.program-card').forEach((card) => {
      card.addEventListener('click', (e) => {
        e.preventDefault();
        const slug = card.getAttribute('data-tab');
        if (slug) showPanel(slug);
      });
    });
    const initial = window.location.hash.replace(/^#/, '');
    if (initial && document.querySelector(`[data-panel="${initial}"]`)) {
      showPanel(initial, { updateHash: false });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
</script>

<style>
  .hero-banner {
    height: 260px;
    position: relative;
    overflow: hidden;
    background-size: cover;
    background-position: center;
  }
  .hero-overlay {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 30% 50%, rgba(255,255,255,0.08) 0%, transparent 50%);
  }

  .hero-text { padding: 3rem 0 2.5rem; }
  .hero-split {
    display: grid;
    grid-template-columns: 1fr 1.6fr;
    gap: 3rem;
    align-items: start;
  }
  .hero-split h1 { font-size: 2.1rem; font-weight: 700; line-height: 1.3; }
  .hero-split p {
    font-size: 0.98rem;
    color: var(--text-secondary);
    line-height: 1.9;
    padding-top: 0.4rem;
  }

  .programs { padding: 0 0 4rem; }

  .program-cards {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
    margin-bottom: 2.5rem;
    list-style: none;
    padding: 0;
  }

  .program-card {
    display: flex;
    flex-direction: column;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    text-align: start;
    cursor: pointer;
    font: inherit;
    padding: 0;
    transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s;
  }

  .program-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
    border-color: var(--huji-teal-light);
  }

  .program-card:hover .arrow { transform: translateX(-3px); }

  .card-img {
    aspect-ratio: 4/3;
    background-size: cover;
    background-position: center;
    background-color: var(--bg-secondary);
  }

  .card-content {
    padding: 1rem 1.1rem 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    flex: 1;
  }

  .card-name {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-primary);
    line-height: 1.4;
  }

  .card-tagline {
    font-size: 0.82rem;
    color: var(--text-secondary);
    line-height: 1.7;
    flex: 1;
  }

  .card-cta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 0.5rem;
    padding-top: 0.6rem;
    border-top: 1px solid var(--border-light);
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--text-muted);
  }

  .arrow { color: var(--text-muted); transition: transform 0.15s; }

  .card-active {
    border-color: var(--huji-teal);
    box-shadow: 0 0 0 1px var(--huji-teal), var(--shadow-md);
  }
  .card-active .card-name { color: var(--huji-teal-dark); }
  .card-active .card-cta { color: var(--huji-teal); }
  .card-active .arrow { color: var(--huji-teal); }
  .card-active .cta-label::before {
    content: "● ";
    color: var(--huji-teal);
    font-size: 0.7em;
    margin-inline-end: 0.15rem;
  }
  .card-active .cta-label { color: var(--huji-teal); }

  .panel { display: none; }
  .panel-visible { display: block; }

  .panel-header { margin-bottom: 1.5rem; }

  .panel-eyebrow {
    font-size: 0.78rem;
    color: var(--huji-teal);
    font-weight: 600;
    margin-bottom: 0.5rem;
  }

  .panel-faculty { color: var(--text-muted); font-weight: 500; }

  .panel-header h2 {
    font-size: 1.65rem;
    font-weight: 700;
    line-height: 1.3;
    margin-bottom: 0.5rem;
  }

  .panel-tagline {
    font-size: 1rem;
    color: var(--text-secondary);
    line-height: 1.7;
  }

  .highlights {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin: 0 0 1.75rem;
  }

  .highlight-chip {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
    padding: 0.4rem 0.8rem;
    background: var(--huji-teal-light);
    border-radius: 999px;
    font-size: 0.8rem;
    line-height: 1;
  }

  .highlight-label {
    color: var(--text-muted);
    font-weight: 500;
    letter-spacing: 0.04em;
    font-size: 0.7rem;
  }

  .highlight-value {
    color: var(--huji-teal-dark);
    font-weight: 600;
  }

  .panel-body {
    max-width: 760px;
    color: var(--text-primary);
  }

  .panel-body :global(h2) {
    font-size: 1.15rem;
    font-weight: 700;
    margin-top: 1.5rem;
    margin-bottom: 0.6rem;
    color: var(--text-primary);
  }

  .panel-body :global(p) {
    font-size: 0.95rem;
    color: var(--text-secondary);
    line-height: 1.85;
    margin-bottom: 0.9rem;
  }

  .panel-body :global(ul) {
    margin: 0.6rem 0 1rem;
    padding-inline-start: 1.25rem;
  }

  .panel-body :global(li) {
    font-size: 0.92rem;
    color: var(--text-secondary);
    line-height: 1.8;
    margin-bottom: 0.45rem;
  }

  .panel-body :global(li strong) { color: var(--text-primary); }

  .panel-body :global(strong) { color: var(--text-primary); font-weight: 600; }

  .panel-body :global(blockquote) {
    border-inline-start: 3px solid var(--huji-teal);
    background: var(--bg-secondary);
    padding: 0.85rem 1.1rem;
    border-radius: var(--radius);
    margin: 1rem 0;
    font-size: 0.9rem;
    color: var(--text-secondary);
  }

  .callout-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin: 1.75rem 0 0;
  }

  .callout {
    padding: 1.1rem 1.2rem;
    background: var(--bg-secondary);
    border-radius: var(--radius);
    border-inline-start: 3px solid var(--huji-teal);
  }

  .callout-title {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--huji-teal-dark);
    margin: 0 0 0.4rem;
  }

  .callout p {
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.8;
    margin: 0;
  }

  .panel-footer {
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-light);
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    align-items: center;
  }

  .cta-button {
    display: inline-block;
    padding: 0.65rem 1.4rem;
    background: var(--huji-teal-dark);
    color: #fff;
    border-radius: var(--radius);
    font-weight: 500;
    font-size: 0.9rem;
    transition: background 0.15s;
  }
  .cta-button:hover { background: var(--huji-teal); text-decoration: none; }

  .cta-link {
    font-size: 0.88rem;
    color: var(--huji-teal);
    text-decoration: none;
  }
  .cta-link:hover { text-decoration: underline; }

  @media (max-width: 900px) {
    .program-cards { grid-template-columns: 1fr; gap: 0.9rem; }
    .card-img { aspect-ratio: 16/9; }
    .callout-grid { grid-template-columns: 1fr; }
  }

  @media (max-width: 768px) {
    .hero-split { grid-template-columns: 1fr; gap: 1rem; }
    .hero-split h1 { font-size: 1.6rem; }
    .panel-header h2 { font-size: 1.35rem; }
  }
</style>
