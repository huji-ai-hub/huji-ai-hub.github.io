---
import Base from '../../layouts/Base.astro';
import { getCollection, getEntry } from 'astro:content';

const page = (await getEntry('pageContent', 'home'))!.data;

const featuredNews = (await getCollection('news', (n) => n.data.featured))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 8);
---

<Base
  title="מרכז AI | האוניברסיטה העברית"
  lang="he"
  description="מחקר, לימודים ושיתופי פעולה עם תעשייה בבינה מלאכותית, באוניברסיטה העברית בירושלים, בית הספר להנדסה ולמדעי המחשב ע&quot;ש רחל וסלים בנין."
>
  <section class="hero-banner" style={`background-image: url('${page.heroImage}');`}>
    <div class="hero-overlay"></div>
  </section>

  <section class="hero-text">
    <div class="container">
      <div class="hero-split">
        <h1>{page.heroTitleHe}</h1>
        <p>{page.heroBodyHe}</p>
      </div>
    </div>
  </section>

  <section class="pillars">
    <div class="container">
      <div class="pillar-grid">
        {page.pillars.map(p => (
          <a href={p.hrefHe} class="pillar-card">
            <div class="pillar-img" style={`background-image: url('${p.image}');`}></div>
            <div class="pillar-label">
              <span>{p.labelHe}</span>
              <span class="arrow">←</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="program-spotlight">
    <div class="container">
      <div class="spotlight-split">
        <div class="spotlight-img" style={`background-image: url('${page.spotlight.image}');`}></div>
        <div class="spotlight-content">
          <h2>{page.spotlight.titleHe}</h2>
          {page.spotlight.bodyHe.map(p => <p>{p}</p>)}
          <a href={page.spotlight.ctaHrefHe} class="cta-button">{page.spotlight.ctaHe}</a>
        </div>
      </div>
    </div>
  </section>

  <section class="news">
    <div class="container">
      <div class="news-head">
        <h2>{page.newsTitleHe}</h2>
        <a href="/he/news" class="news-all">כל החדשות ←</a>
      </div>
      <div class="news-grid">
        {featuredNews.map(n => (
          <a href={n.data.linkTo ? `/he${n.data.linkTo}` : `/he/news/${n.data.slug}`} class="news-card">
            {n.data.image && (
              <div class="news-img" style={`background-image: url('${n.data.image}');`}></div>
            )}
            <div class="news-label">
              <span>{n.data.titleHe}</span>
              <span class="arrow">←</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .hero-banner {
    height: 320px;
    position: relative;
    overflow: hidden;
    background-size: cover;
    background-position: center;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(13,40,71,0.15) 0%, rgba(13,40,71,0.05) 100%);
  }

  .hero-text { padding: 3.5rem 0 3rem; }

  .hero-split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: start;
  }

  .hero-split h1 {
    font-size: 2.6rem;
    font-weight: 700;
    line-height: 1.3;
    color: var(--text-primary);
  }

  .hero-split p {
    font-size: 0.95rem;
    color: var(--text-secondary);
    line-height: 1.85;
    padding-top: 0.5rem;
  }

  .pillars { background: var(--bg-secondary); padding: 3.5rem 0; }

  .pillar-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .pillar-card {
    text-decoration: none;
    color: inherit;
    transition: transform 0.2s;
  }

  .pillar-card:hover { transform: translateY(-3px); text-decoration: none; }

  .pillar-img {
    aspect-ratio: 4/3;
    border-radius: var(--radius);
    margin-bottom: 0.75rem;
    background-size: cover;
    background-position: center;
  }

  .pillar-label {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--text-primary);
    padding: 0 0.1rem;
  }

  .arrow { color: var(--text-muted); transition: transform 0.15s; }
  .pillar-card:hover .arrow { transform: translateX(-3px); }

  .program-spotlight { padding: 4rem 0; }

  .spotlight-split {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 2.5rem;
    align-items: start;
  }

  .spotlight-img {
    aspect-ratio: 1/1;
    border-radius: var(--radius);
    border: 1px solid var(--border-light);
    background-size: cover;
    background-position: center;
  }

  .spotlight-content h2 {
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.4;
    color: var(--text-primary);
    margin-bottom: 1rem;
  }

  .spotlight-content p {
    font-size: 0.88rem;
    color: var(--text-secondary);
    line-height: 1.85;
    margin-bottom: 0.75rem;
  }

  .cta-button {
    display: inline-block;
    margin-top: 0.75rem;
    padding: 0.65rem 1.5rem;
    background: var(--huji-teal-dark);
    color: #fff;
    border-radius: var(--radius);
    font-weight: 500;
    font-size: 0.85rem;
    transition: background 0.15s;
  }

  .cta-button:hover { background: var(--huji-teal); text-decoration: none; }

  .news { background: var(--bg-secondary); padding: 3.5rem 0; }

  .news-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 1.5rem;
  }

  .news h2 {
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .news-all {
    font-size: 0.85rem;
    color: var(--huji-teal);
    font-weight: 500;
  }
  .news-all:hover { text-decoration: underline; }

  .news-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  .news-card {
    text-decoration: none;
    color: inherit;
    transition: transform 0.2s;
  }

  .news-card:hover { transform: translateY(-3px); text-decoration: none; }

  .news-img {
    aspect-ratio: 16/9;
    border-radius: var(--radius);
    margin-bottom: 0.75rem;
    background-size: cover;
    background-position: center;
  }

  .news-label {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--text-primary);
    padding: 0 0.1rem;
    gap: 1rem;
  }

  .news-card:hover .arrow { transform: translateX(-3px); }

  @media (max-width: 768px) {
    .hero-split { grid-template-columns: 1fr; gap: 1rem; }
    .hero-split h1 { font-size: 1.9rem; }
    .pillar-grid, .news-grid { grid-template-columns: 1fr; }
    .spotlight-split { grid-template-columns: 1fr; }
    .hero-banner { height: 220px; }
  }
</style>
