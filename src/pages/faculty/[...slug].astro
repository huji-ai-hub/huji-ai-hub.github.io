---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const faculty = await getCollection('faculty');
  return faculty.map((member) => ({
    params: { slug: member.id },
    props: { member },
  }));
}

const { member } = Astro.props;
const { Content } = await render(member);

const description = `${member.data.name}, ${member.data.title} at the Hebrew University of Jerusalem. ${member.data.lab}.`;

const sameAs = [member.data.website, member.data.scholar].filter(Boolean);

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: member.data.name,
  jobTitle: member.data.title,
  affiliation: {
    '@type': 'CollegeOrUniversity',
    name: 'The Hebrew University of Jerusalem',
    url: 'https://new.huji.ac.il/',
  },
  worksFor: {
    '@type': 'Organization',
    name: 'HUJI AI Hub',
    url: Astro.site?.toString(),
  },
  url: new URL(Astro.url.pathname, Astro.site).toString(),
  ...(member.data.photo && { image: new URL(member.data.photo, Astro.site).toString() }),
  ...(sameAs.length > 0 && { sameAs }),
};
---

<Base
  title={`${member.data.name} — HUJI AI Hub`}
  description={description}
  pageType="profile"
  image={member.data.photo}
>
  <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  <section class="profile">
    <div class="container">
      <a href="/faculty" class="back">← Back to Faculty</a>
      <div class="profile-header">
        <div class="avatar">
          {member.data.photo ? (
            <img src={member.data.photo} alt={member.data.name} />
          ) : (
            <span>{member.data.name.split(' ').map(n => n[0]).join('')}</span>
          )}
        </div>
        <div>
          <h1>{member.data.name}</h1>
          <p class="title">{member.data.title}</p>
          <p class="lab">{member.data.lab}</p>
          <div class="links">
            {member.data.website && <a href={member.data.website} target="_blank">Website ↗</a>}
            {member.data.scholar && <a href={member.data.scholar} target="_blank">Google Scholar ↗</a>}
          </div>
        </div>
      </div>

      {member.data.areas && member.data.areas.length > 0 && (
        <div class="areas">
          {member.data.areas.map(area => <span class="tag">{area}</span>)}
        </div>
      )}

      <div class="bio">
        <Content />
      </div>
    </div>
  </section>
</Base>

<style>
  .profile {
    padding: 2.5rem 0 4rem;
  }

  .back {
    display: inline-block;
    font-size: 0.82rem;
    color: var(--text-muted);
    margin-bottom: 2rem;
  }

  .profile-header {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
    margin-bottom: 1.5rem;
  }

  .avatar {
    width: 96px;
    height: 96px;
    border-radius: 50%;
    background: var(--huji-teal);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 1.6rem;
    flex-shrink: 0;
    overflow: hidden;
  }
  .avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  h1 {
    font-size: 1.6rem;
    font-weight: 700;
    margin-bottom: 0.15rem;
  }

  .title {
    font-size: 0.9rem;
    color: var(--text-secondary);
  }

  .lab {
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-top: 0.1rem;
  }

  .links {
    display: flex;
    gap: 1rem;
    margin-top: 0.6rem;
  }

  .links a {
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--huji-teal);
  }

  .areas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 1.5rem;
  }

  .tag {
    font-size: 0.72rem;
    padding: 0.15rem 0.55rem;
    background: var(--bg-secondary);
    border-radius: 100px;
    color: var(--text-muted);
  }

  .bio {
    max-width: 640px;
    font-size: 0.92rem;
    color: var(--text-secondary);
    line-height: 1.8;
  }
</style>
