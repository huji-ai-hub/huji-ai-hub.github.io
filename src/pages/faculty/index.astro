---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const faculty = await getCollection('faculty');
const sortedFaculty = faculty.sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
---

<Base
  title="Faculty | HUJI AI Hub"
  description="AI faculty at the Hebrew University of Jerusalem, researchers across machine perception, language, foundations of learning, biomedical AI, multi-agent systems, cryptography, data science, and human-centered AI."
>
  <section class="hero-banner" style="background-image: url('/images/pexels-googledeepmind-25626519.jpg');">
    <div class="hero-overlay"></div>
  </section>

  <section class="hero-text">
    <div class="container">
      <div class="hero-split">
        <h1>AI Faculty</h1>
        <p>
          Researchers and educators working on artificial intelligence
          at the Hebrew University.
        </p>
      </div>
    </div>
  </section>

  <section class="listing">
    <div class="container">
      <div class="faculty-grid">
        {sortedFaculty.map((member) => (
          <a
            href={member.data.website || `/faculty/${member.id}`}
            class="faculty-card"
            target={member.data.website ? '_blank' : undefined}
            rel={member.data.website ? 'noopener' : undefined}
          >
            <div class="avatar">
              {member.data.photo ? (
                <img src={member.data.photo} alt={member.data.name} />
              ) : (
                <span>{member.data.name.split(' ').map(n => n[0]).join('')}</span>
              )}
            </div>
            <div class="info">
              <h3>{member.data.name}</h3>
              <p class="ftitle">{member.data.title}</p>
              <p class="flab">{member.data.lab}</p>
              {member.data.areas && member.data.areas.length > 0 && (
                <div class="areas">
                  {member.data.areas.map(area => <span class="tag">{area}</span>)}
                </div>
              )}
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .hero-banner {
    height: 220px;
    position: relative;
    background-size: cover;
    background-position: center;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 30% 50%, rgba(100,180,220,0.15) 0%, transparent 50%);
  }

  .hero-text {
    padding: 3rem 0 2.5rem;
  }

  .hero-split {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
    align-items: start;
  }

  .hero-split h1 {
    font-size: 2.2rem;
    font-weight: 700;
    line-height: 1.15;
  }

  .hero-split p {
    font-size: 0.95rem;
    color: var(--text-secondary);
    line-height: 1.75;
  }

  .listing {
    padding: 0 0 3rem;
  }

  .faculty-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  .faculty-card {
    display: flex;
    gap: 0.85rem;
    padding: 1rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    text-decoration: none;
    color: inherit;
    transition: box-shadow 0.15s, border-color 0.15s;
  }

  .faculty-card:hover {
    box-shadow: var(--shadow-md);
    border-color: var(--huji-teal);
    text-decoration: none;
  }

  .avatar {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--huji-teal);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 600;
    font-size: 0.95rem;
    flex-shrink: 0;
    overflow: hidden;
  }
  .avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .info h3 {
    font-size: 0.88rem;
    font-weight: 600;
  }

  .ftitle {
    font-size: 0.78rem;
    color: var(--text-secondary);
  }

  .flab {
    font-size: 0.75rem;
    color: var(--text-muted);
    margin-top: 0.1rem;
  }

  .areas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    margin-top: 0.4rem;
  }

  .tag {
    font-size: 0.65rem;
    padding: 0.1rem 0.45rem;
    background: var(--bg-secondary);
    border-radius: 100px;
    color: var(--text-muted);
  }

  @media (max-width: 768px) {
    .hero-split { grid-template-columns: 1fr; gap: 1rem; }
    .faculty-grid { grid-template-columns: 1fr; }
  }
</style>
