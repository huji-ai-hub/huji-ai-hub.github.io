---
import Base from '../layouts/Base.astro';
import { getCollection, getEntry } from 'astro:content';

const fieldEntries = (await getCollection('fields'))
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99))
  .map(e => e.data);

const labEntries = (await getCollection('labs'))
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99))
  .map(e => e.data);

const featuredBlocks = (await getCollection('featured', e => e.data.page === 'research'))
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99))
  .map(e => e.data);

const page = (await getEntry('pageContent', 'research'))!.data;
---

<Base
  title="Research | HUJI AI Hub"
  description="AI research at the Hebrew University spans machine perception, language and cognition, foundations of learning, biomedical AI, multi-agent systems, cyber and cryptography, data science, and human-centered AI."
>
  <section class="hero-banner" style="background-image: url('/images/pexels-googledeepmind-17485658.jpg');">
    <div class="hero-overlay"></div>
  </section>

  <section class="hero-text">
    <div class="container">
      <div class="hero-split">
        <h1>{page.heroTitle}</h1>
        <p>{page.heroBody}</p>
      </div>
    </div>
  </section>

  {page.introTitle && (
    <section class="vision">
      <div class="container">
        <div class="vision-inner">
          <h2>{page.introTitle}</h2>
          <p>{page.introBody}</p>
        </div>
      </div>
    </section>
  )}

  <section class="fields">
    <div class="container">
      <h2>Fields of Research</h2>
      <div class="fields-grid">
        {fieldEntries.map(field => (
          <a href={`/research/${field.slug}`} class="field-card">
            <div class="field-img" style={field.image ? `background-image: url('${field.image}');` : `background: ${field.gradient};`}></div>
            <div class="field-label">
              <span>{field.title}</span>
              <span class="arrow">→</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  {featuredBlocks.map(block => (
    <section class="featured-group">
      <div class="container">
        <div class="featured-split">
          <div>
            <h2>{block.title}</h2>
            <p>{block.body}</p>
            <a href={block.ctaHref} class="cta-button" target="_blank" rel="noopener">
              {block.ctaLabel}
            </a>
          </div>
          <div class="featured-img" style={`background-image: url('${block.image}');`}></div>
        </div>
      </div>
    </section>
  ))}

  <section class="labs">
    <div class="container">
      <h2>Spotlight: Our Labs</h2>
      <div class="labs-grid">
        {labEntries.map(lab => (
          <a href={lab.url} class="lab-card" target="_blank">
            <div class="lab-img" style={`background-image: url('${lab.image}');`}></div>
            <div class="lab-label">
              <span>{lab.name}</span>
              <span class="lab-desc">{lab.description}</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .hero-banner {
    height: 180px;
    background: linear-gradient(135deg, #0d2847 0%, #1a4a6a 40%, #2a6b8a 100%);
    position: relative;
    overflow: hidden;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 30% 50%, rgba(100,180,220,0.15) 0%, transparent 50%),
      radial-gradient(circle at 70% 30%, rgba(150,200,240,0.1) 0%, transparent 40%);
  }

  .hero-text {
    padding: 3rem 0 2.5rem;
  }

  .hero-split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: start;
  }

  .hero-split h1 {
    font-size: 2.2rem;
    font-weight: 700;
    line-height: 1.15;
    color: var(--text-primary);
  }

  .hero-split p {
    font-size: 0.95rem;
    color: var(--text-secondary);
    line-height: 1.75;
    padding-top: 0.3rem;
  }

  .vision {
    background: var(--bg-secondary);
    padding: 3rem 0;
  }

  .vision-inner {
    max-width: 720px;
  }

  .vision h2 {
    font-size: 1.3rem;
    font-weight: 700;
    margin-bottom: 0.75rem;
    color: var(--text-primary);
  }

  .vision p {
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.75;
  }

  .fields {
    padding: 3.5rem 0;
  }

  .fields h2, .labs h2 {
    font-size: 1.3rem;
    font-weight: 700;
    margin-bottom: 1.5rem;
    color: var(--text-primary);
  }

  .featured-group {
    padding: 3.5rem 0;
    background: var(--bg-secondary);
  }

  .featured-split {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 2.5rem;
    align-items: center;
  }

  .featured-split h2 {
    font-size: 1.6rem;
    font-weight: 700;
    line-height: 1.3;
    margin-bottom: 1rem;
  }

  .featured-split p {
    font-size: 0.95rem;
    color: var(--text-secondary);
    line-height: 1.85;
    margin-bottom: 1.25rem;
  }

  .featured-img {
    aspect-ratio: 4/3;
    border-radius: var(--radius);
    background-size: cover;
    background-position: center;
  }

  .cta-button {
    display: inline-block;
    padding: 0.65rem 1.5rem;
    background: var(--huji-teal-dark);
    color: #fff;
    border-radius: var(--radius);
    font-weight: 500;
    font-size: 0.85rem;
    transition: background 0.15s;
  }

  .cta-button:hover {
    background: var(--huji-teal);
    text-decoration: none;
  }

  .fields-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
  }

  .field-card {
    text-decoration: none;
    color: inherit;
    transition: transform 0.2s;
  }

  .field-card:hover {
    transform: translateY(-3px);
    text-decoration: none;
  }

  .field-img {
    aspect-ratio: 4/3;
    border-radius: var(--radius);
    margin-bottom: 0.6rem;
    background-size: cover;
    background-position: center;
  }

  .field-label {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--text-primary);
  }

  .arrow {
    color: var(--text-muted);
    transition: transform 0.15s;
  }

  .field-card:hover .arrow,
  .lab-card:hover .arrow {
    transform: translateX(3px);
  }

  .labs {
    padding: 3.5rem 0;
  }

  /* Flex (not grid) so the trailing partial row (2 of 5) centers nicely. */
  .labs-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.25rem;
  }

  .lab-card {
    text-decoration: none;
    color: inherit;
    transition: transform 0.2s;
    /* Three per row at desktop widths: 33% minus the gap allotment. */
    flex: 0 1 calc((100% - 2.5rem) / 3);
    min-width: 240px;
  }

  .lab-card:hover {
    transform: translateY(-3px);
    text-decoration: none;
  }

  .lab-img {
    aspect-ratio: 16/9;
    border-radius: var(--radius);
    margin-bottom: 0.6rem;
    background-size: cover;
    background-position: center;
  }

  .lab-label span:first-child {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-primary);
    display: block;
    margin-bottom: 0.15rem;
  }

  .lab-desc {
    font-size: 0.78rem;
    color: var(--text-muted);
    font-weight: 400 !important;
  }

  @media (max-width: 768px) {
    .hero-split, .featured-split { grid-template-columns: 1fr; gap: 1rem; }
    .hero-split h1 { font-size: 1.8rem; }
    .fields-grid { grid-template-columns: repeat(2, 1fr); }
    .labs-grid { grid-template-columns: 1fr; }
  }
</style>
