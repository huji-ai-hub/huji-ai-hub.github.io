---
import Base from '../layouts/Base.astro';
import { FIELDS } from '../data/fields';
---

<Base
  title="Research | HUJI AI Hub"
  description="AI research at the Hebrew University spans machine perception, language and cognition, foundations of learning, biomedical AI, multi-agent systems, cyber and cryptography, data science, and human-centered AI."
>
  <section class="hero-banner" style="background-image: url('/images/pexels-googledeepmind-17485658.jpg');">
    <div class="hero-overlay"></div>
  </section>

  <section class="hero-text">
    <div class="container">
      <div class="hero-split">
        <h1>The Frontiers of AI Research</h1>
        <p>
          Unlocking the "black box" and developing the models that will shape the coming decades.
        </p>
      </div>
    </div>
  </section>

  <section class="vision">
    <div class="container">
      <div class="vision-inner">
        <h2>Our Research Vision</h2>
        <p>
          Alongside developing existing AI applications, our researchers tackle the questions of tomorrow.
          Our research bridges theoretical foundations and real-world impact, from understanding how neural
          networks learn, to building systems that perceive, reason, and act in complex environments.
        </p>
      </div>
    </div>
  </section>

  <section class="fields">
    <div class="container">
      <h2>Fields of Research</h2>
      <div class="fields-grid">
        {FIELDS.map(field => (
          <a href={`/research/${field.slug}`} class="field-card">
            <div class="field-img" style={field.image ? `background-image: url('${field.image}');` : `background: ${field.gradient};`}></div>
            <div class="field-label">
              <span>{field.title}</span>
              <span class="arrow">→</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="featured-group">
    <div class="container">
      <div class="featured-split">
        <div>
          <h2>Beyond Human Vision: The Machine Perception Group</h2>
          <p>
            The Machine Perception Group at the School of Computer Science and Engineering develops
            algorithms and methods that will allow computers to reach the remarkable performance
            of humans, and in some cases even surpass human ability.
          </p>
          <a href="https://vision.huji.ac.il/main/" class="cta-button" target="_blank" rel="noopener">
            Read more →
          </a>
        </div>
        <div class="featured-img" style="background-image: url('/images/pexels-googledeepmind-25626512.jpg');"></div>
      </div>
    </div>
  </section>

  <section class="labs">
    <div class="container">
      <h2>Spotlight: Our Labs</h2>
      <div class="labs-grid">
        <a href="https://schwartz-lab-huji.github.io/" class="lab-card" target="_blank">
          <div class="lab-img" style="background-image: url('/images/pexels-googledeepmind-17483868.jpg');"></div>
          <div class="lab-label">
            <span>Schwartz Lab</span>
            <span class="lab-desc">Making text understanding technology widely accessible</span>
          </div>
        </a>
        <a href="https://www.katz-lab.com/about" class="lab-card" target="_blank">
          <div class="lab-img" style="background-image: url('/images/pexels-googledeepmind-18069241.jpg');"></div>
          <div class="lab-label">
            <span>Katz Lab</span>
            <span class="lab-desc">Verifying the correctness of AI-created systems</span>
          </div>
        </a>
        <a href="https://www.cs.huji.ac.il/~josko/casmip-lab/" class="lab-card" target="_blank">
          <div class="lab-img" style="background-image: url('/images/pexels-googledeepmind-25626428.jpg');"></div>
          <div class="lab-label">
            <span>CASMIP Lab</span>
            <span class="lab-desc">Computer Aided Surgery and Medical Image Processing</span>
          </div>
        </a>
        <a href="https://www.cs.huji.ac.il/~dina/" class="lab-card" target="_blank">
          <div class="lab-img" style="background-image: url('/images/pexels-googledeepmind-18069696.jpg');"></div>
          <div class="lab-label">
            <span>Schneidman Lab</span>
            <span class="lab-desc">Integrative Structure Modeling</span>
          </div>
        </a>
        <a href="https://www.cs.huji.ac.il/~adiyoss/slprl/index.html" class="lab-card" target="_blank">
          <div class="lab-img" style="background-image: url('/images/pexels-cottonbro-6153739.jpg');"></div>
          <div class="lab-label">
            <span>SLP Research Lab</span>
            <span class="lab-desc">Spoken Language Processing</span>
          </div>
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero-banner {
    height: 180px;
    background: linear-gradient(135deg, #0d2847 0%, #1a4a6a 40%, #2a6b8a 100%);
    position: relative;
    overflow: hidden;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 30% 50%, rgba(100,180,220,0.15) 0%, transparent 50%),
      radial-gradient(circle at 70% 30%, rgba(150,200,240,0.1) 0%, transparent 40%);
  }

  .hero-text {
    padding: 3rem 0 2.5rem;
  }

  .hero-split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: start;
  }

  .hero-split h1 {
    font-size: 2.2rem;
    font-weight: 700;
    line-height: 1.15;
    color: var(--text-primary);
  }

  .hero-split p {
    font-size: 0.95rem;
    color: var(--text-secondary);
    line-height: 1.75;
    padding-top: 0.3rem;
  }

  .vision {
    background: var(--bg-secondary);
    padding: 3rem 0;
  }

  .vision-inner {
    max-width: 720px;
  }

  .vision h2 {
    font-size: 1.3rem;
    font-weight: 700;
    margin-bottom: 0.75rem;
    color: var(--text-primary);
  }

  .vision p {
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.75;
  }

  .fields {
    padding: 3.5rem 0;
  }

  .fields h2, .labs h2 {
    font-size: 1.3rem;
    font-weight: 700;
    margin-bottom: 1.5rem;
    color: var(--text-primary);
  }

  .featured-group {
    padding: 3.5rem 0;
    background: var(--bg-secondary);
  }

  .featured-split {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 2.5rem;
    align-items: center;
  }

  .featured-split h2 {
    font-size: 1.6rem;
    font-weight: 700;
    line-height: 1.3;
    margin-bottom: 1rem;
  }

  .featured-split p {
    font-size: 0.95rem;
    color: var(--text-secondary);
    line-height: 1.85;
    margin-bottom: 1.25rem;
  }

  .featured-img {
    aspect-ratio: 4/3;
    border-radius: var(--radius);
    background-size: cover;
    background-position: center;
  }

  .cta-button {
    display: inline-block;
    padding: 0.65rem 1.5rem;
    background: var(--huji-teal-dark);
    color: #fff;
    border-radius: var(--radius);
    font-weight: 500;
    font-size: 0.85rem;
    transition: background 0.15s;
  }

  .cta-button:hover {
    background: var(--huji-teal);
    text-decoration: none;
  }

  .fields-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
  }

  .field-card {
    text-decoration: none;
    color: inherit;
    transition: transform 0.2s;
  }

  .field-card:hover {
    transform: translateY(-3px);
    text-decoration: none;
  }

  .field-img {
    aspect-ratio: 4/3;
    border-radius: var(--radius);
    margin-bottom: 0.6rem;
    background-size: cover;
    background-position: center;
  }

  .field-label {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--text-primary);
  }

  .arrow {
    color: var(--text-muted);
    transition: transform 0.15s;
  }

  .field-card:hover .arrow,
  .lab-card:hover .arrow {
    transform: translateX(3px);
  }

  .labs {
    padding: 3.5rem 0;
  }

  .labs-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }

  .lab-card {
    text-decoration: none;
    color: inherit;
    transition: transform 0.2s;
  }

  .lab-card:hover {
    transform: translateY(-3px);
    text-decoration: none;
  }

  .lab-img {
    aspect-ratio: 16/9;
    border-radius: var(--radius);
    margin-bottom: 0.6rem;
    background-size: cover;
    background-position: center;
  }

  .lab-label span:first-child {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-primary);
    display: block;
    margin-bottom: 0.15rem;
  }

  .lab-desc {
    font-size: 0.78rem;
    color: var(--text-muted);
    font-weight: 400 !important;
  }

  @media (max-width: 768px) {
    .hero-split, .featured-split { grid-template-columns: 1fr; gap: 1rem; }
    .hero-split h1 { font-size: 1.8rem; }
    .fields-grid { grid-template-columns: repeat(2, 1fr); }
    .labs-grid { grid-template-columns: 1fr; }
  }
</style>
