---
import Base from '../layouts/Base.astro';
---

<Base title="HUJI AI Hub — Artificial Intelligence at the Hebrew University">
  <section class="hero-banner">
    <div class="hero-overlay"></div>
  </section>

  <section class="hero-text">
    <div class="container">
      <div class="hero-split">
        <h1>AI at the Hebrew University</h1>
        <p>
          Artificial Intelligence impacts every aspect of life. At the Hebrew University,
          we research and teach diverse disciplines in the foundations, applications,
          and implications of AI.
        </p>
      </div>
    </div>
  </section>

  <section class="pillars">
    <div class="container">
      <div class="pillar-grid">
        <a href="/research" class="pillar-card">
          <div class="pillar-img" style="background: linear-gradient(135deg, #1a3a4a 0%, #2d6b7a 100%);"></div>
          <div class="pillar-label">
            <span>Research</span>
            <span class="arrow">→</span>
          </div>
        </a>
        <a href="/academics" class="pillar-card">
          <div class="pillar-img" style="background: linear-gradient(135deg, #3a2a5a 0%, #6b5a8a 100%);"></div>
          <div class="pillar-label">
            <span>Academics</span>
            <span class="arrow">→</span>
          </div>
        </a>
        <a href="/industry" class="pillar-card">
          <div class="pillar-img" style="background: linear-gradient(135deg, #2a4a3a 0%, #4a7a5a 100%);"></div>
          <div class="pillar-label">
            <span>Industry</span>
            <span class="arrow">→</span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <section class="program-spotlight">
    <div class="container">
      <div class="spotlight-split">
        <div class="spotlight-img" style="background: linear-gradient(135deg, #1a3a4a 0%, #2d6b7a 100%);"></div>
        <div class="spotlight-content">
          <h2>Mastering the Tech of Tomorrow: Computer Science in the AI Era</h2>
          <p>
            The new Computer Science program at the Hebrew University, featuring an AI specialization,
            is designed for students aspiring to understand how this generation's tools work — and to
            develop the next generation's tools. The program was developed by leading researchers,
            combining theoretical depth with practical application.
          </p>
          <p>
            It provides a solid mathematical foundation and deep exposure to modern models, training
            graduates capable of analyzing, training, and critically examining complex systems.
            Here, you acquire the knowledge needed to lead R&D in a changing technological environment.
          </p>
          <a href="/academics" class="cta-button">Details & Registration →</a>
        </div>
      </div>
    </div>
  </section>

  <section class="news">
    <div class="container">
      <h2>Latest in AI at Hebrew University</h2>
      <div class="news-grid">
        <a href="/about" class="news-card">
          <div class="news-img" style="background: linear-gradient(135deg, #2a4a3a 0%, #4a7a5a 100%);"></div>
          <div class="news-label">
            <span>CS AI Program</span>
            <span class="arrow">→</span>
          </div>
        </a>
        <a href="/about" class="news-card">
          <div class="news-img" style="background: linear-gradient(135deg, #3a2a5a 0%, #5a4a7a 100%);"></div>
          <div class="news-label">
            <span>New Course — Programming with AI Agents</span>
            <span class="arrow">→</span>
          </div>
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero-banner {
    height: 200px;
    background: linear-gradient(135deg, #0d2847 0%, #1a4a6a 40%, #2a6b8a 100%);
    position: relative;
    overflow: hidden;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 30% 50%, rgba(100,180,220,0.15) 0%, transparent 50%),
      radial-gradient(circle at 70% 30%, rgba(150,200,240,0.1) 0%, transparent 40%);
  }

  .hero-text {
    padding: 3.5rem 0 3rem;
  }

  .hero-split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: start;
  }

  .hero-split h1 {
    font-size: 2.4rem;
    font-weight: 700;
    line-height: 1.15;
    color: var(--text-primary);
  }

  .hero-split p {
    font-size: 0.95rem;
    color: var(--text-secondary);
    line-height: 1.75;
    padding-top: 0.5rem;
  }

  .pillars {
    background: var(--bg-secondary);
    padding: 3.5rem 0;
  }

  .pillar-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .pillar-card {
    text-decoration: none;
    color: inherit;
    transition: transform 0.2s;
  }

  .pillar-card:hover {
    transform: translateY(-3px);
    text-decoration: none;
  }

  .pillar-img {
    aspect-ratio: 4/3;
    border-radius: var(--radius);
    margin-bottom: 0.75rem;
  }

  .pillar-label {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--text-primary);
    padding: 0 0.1rem;
  }

  .arrow {
    color: var(--text-muted);
    transition: transform 0.15s;
  }

  .pillar-card:hover .arrow {
    transform: translateX(3px);
  }

  .program-spotlight {
    padding: 4rem 0;
  }

  .spotlight-split {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 2.5rem;
    align-items: start;
  }

  .spotlight-img {
    aspect-ratio: 1/1;
    border-radius: var(--radius);
    border: 1px solid var(--border-light);
  }

  .spotlight-content h2 {
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.3;
    color: var(--text-primary);
    margin-bottom: 1rem;
  }

  .spotlight-content p {
    font-size: 0.88rem;
    color: var(--text-secondary);
    line-height: 1.75;
    margin-bottom: 0.75rem;
  }

  .cta-button {
    display: inline-block;
    margin-top: 0.75rem;
    padding: 0.65rem 1.5rem;
    background: var(--huji-teal-dark);
    color: #fff;
    border-radius: var(--radius);
    font-weight: 500;
    font-size: 0.85rem;
    transition: background 0.15s;
  }

  .cta-button:hover {
    background: var(--huji-teal);
    text-decoration: none;
  }

  .news {
    background: var(--bg-secondary);
    padding: 3.5rem 0;
  }

  .news h2 {
    font-size: 1.4rem;
    font-weight: 700;
    margin-bottom: 1.5rem;
    color: var(--text-primary);
  }

  .news-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  .news-card {
    text-decoration: none;
    color: inherit;
    transition: transform 0.2s;
  }

  .news-card:hover {
    transform: translateY(-3px);
    text-decoration: none;
  }

  .news-img {
    aspect-ratio: 16/9;
    border-radius: var(--radius);
    margin-bottom: 0.75rem;
  }

  .news-label {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--text-primary);
    padding: 0 0.1rem;
    gap: 1rem;
  }

  .news-card:hover .arrow {
    transform: translateX(3px);
  }

  @media (max-width: 768px) {
    .hero-split { grid-template-columns: 1fr; gap: 1rem; }
    .hero-split h1 { font-size: 1.8rem; }
    .pillar-grid { grid-template-columns: 1fr; }
    .spotlight-split { grid-template-columns: 1fr; }
    .news-grid { grid-template-columns: 1fr; }
  }
</style>
