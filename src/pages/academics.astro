---
import Base from '../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

// Load programs and order by `order` field (lower numbers first).
const programs = (await getCollection('programs'))
  .sort((a, b) => a.data.order - b.data.order);

// Pre-render each program's markdown body so we can inline it inside its tab panel.
const rendered = await Promise.all(
  programs.map(async (p) => {
    const { Content } = await render(p);
    return { program: p, Content };
  })
);

const pageTitle = 'Academics — AI at the Hebrew University';
const pageDescription =
  "Three undergraduate paths into AI at the Hebrew University: the CS+AI emphasis, the MaTaR excellence track combining math, CS and physics, and the single-major Computer Science & Computational Biology program. Built for students who want to understand how AI systems actually work.";

// Build a JSON-LD EducationalOccupationalProgram block per program — Google's
// rich-result schema for academic programs. Helps search visibility.
const programLd = programs.map((p) => ({
  '@context': 'https://schema.org',
  '@type': 'EducationalOccupationalProgram',
  name: p.data.name,
  alternateName: p.data.nameHe,
  description: p.data.seoDescription,
  url: `https://huji-ai-hub.pages.dev/academics#${p.data.slug}`,
  educationalProgramMode: 'full-time',
  occupationalCategory: 'Computer Science / Artificial Intelligence',
  programType: p.data.type,
  educationalCredentialAwarded: p.data.degreeLevel === 'bsc' ? "Bachelor's degree" :
                                 p.data.degreeLevel === 'msc' ? "Master's degree" :
                                 p.data.degreeLevel === 'phd' ? "Doctoral degree" :
                                 'Multiple degree levels',
  provider: {
    '@type': 'CollegeOrUniversity',
    name: 'The Hebrew University of Jerusalem',
    sameAs: 'https://en.huji.ac.il',
  },
  ...(p.data.officialWebsite ? { sameAs: p.data.officialWebsite } : {}),
}));
---

<Base title={pageTitle} description={pageDescription}>
  {programLd.map((ld) => (
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  ))}

  <section class="hero-banner" style="background-image: url('/images/pexels-cottonbro-6153739.jpg');">
    <div class="hero-overlay"></div>
  </section>

  <section class="hero-text">
    <div class="container">
      <div class="hero-split">
        <h1>AI degrees at the Hebrew University</h1>
        <p>
          AI tools are rewriting what it means to be a computer scientist — and that's
          exactly why deep computer science training matters more than ever. The people
          who shape what AI does, where it goes, and how it stays safe are the ones who
          understand how it actually works. Our programs train you to be those people:
          mathematical foundations, classical computer science, and the freedom to
          specialize in the corner of the field that matches what you want to build.
        </p>
      </div>
    </div>
  </section>

  <section class="programs">
    <div class="container">
      <nav class="program-cards" aria-label="AI program tracks">
        {programs.map((p, i) => (
          <a
            href={`#${p.data.slug}`}
            class={`program-card ${i === 0 ? 'card-active' : ''}`}
            data-tab={p.data.slug}
          >
            {p.data.image && (
              <div class="card-img" style={`background-image: url('${p.data.image}');`}></div>
            )}
            <div class="card-content">
              <h3 class="card-name">{p.data.name}</h3>
              <p class="card-tagline">{p.data.tagline}</p>
              <span class="card-cta">
                <span class="cta-label">View program</span>
                <span class="arrow">→</span>
              </span>
            </div>
          </a>
        ))}
      </nav>

      <div class="panels">
        {rendered.map(({ program: p, Content }, i) => (
          <article id={p.data.slug} class={`panel ${i === 0 ? 'panel-default' : ''}`}>
            <header class="panel-header">
              <p class="panel-eyebrow">
                {p.data.degreeLevel === 'bsc' ? "Bachelor's program" :
                 p.data.degreeLevel === 'msc' ? "Master's program" :
                 p.data.degreeLevel === 'phd' ? 'Doctoral program' :
                 'Multi-level program'}
                {p.data.faculty && <span class="panel-faculty"> · {p.data.faculty}</span>}
              </p>
              <h2>{p.data.name}</h2>
              <p class="panel-tagline">{p.data.tagline}</p>
            </header>

            <div class="panel-body">
              <Content />
            </div>

            <footer class="panel-footer">
              {p.data.officialWebsite && (
                <a href={p.data.officialWebsite} target="_blank" rel="noopener" class="cta-button">
                  Official program site ↗
                </a>
              )}
              {p.data.courseListUrl && (
                <a href={p.data.courseListUrl} target="_blank" rel="noopener" class="cta-link">
                  Full course list ↗
                </a>
              )}
              {p.data.structurePdfUrl && (
                <a href={p.data.structurePdfUrl} target="_blank" rel="noopener" class="cta-link">
                  Program structure (PDF) ↗
                </a>
              )}
              {p.data.registrationUrl && p.data.registrationUrl !== p.data.officialWebsite && (
                <a href={p.data.registrationUrl} target="_blank" rel="noopener" class="cta-link">
                  Registration ↗
                </a>
              )}
            </footer>
          </article>
        ))}
      </div>
    </div>
  </section>
</Base>

<script>
  // Sync the active card with the current hash so the highlight follows the panel.
  function updateTabs() {
    const hash = window.location.hash || `#${document.querySelector('.program-card')?.getAttribute('data-tab')}`;
    document.querySelectorAll('.program-card').forEach((card) => {
      const href = card.getAttribute('href');
      card.classList.toggle('card-active', href === hash);
    });
  }
  window.addEventListener('hashchange', updateTabs);
  document.addEventListener('DOMContentLoaded', updateTabs);
</script>

<style>
  .hero-banner {
    height: 260px;
    position: relative;
    overflow: hidden;
    background-size: cover;
    background-position: center;
  }
  .hero-overlay {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 30% 50%, rgba(255,255,255,0.08) 0%, transparent 50%);
  }

  .hero-text { padding: 3rem 0 2.5rem; }
  .hero-split {
    display: grid;
    grid-template-columns: 1fr 1.6fr;
    gap: 3rem;
    align-items: start;
  }
  .hero-split h1 { font-size: 2.2rem; font-weight: 700; line-height: 1.2; }
  .hero-split p {
    font-size: 0.98rem;
    color: var(--text-secondary);
    line-height: 1.8;
    padding-top: 0.4rem;
  }

  .programs {
    padding: 0 0 4rem;
  }

  /* Program selector — clickable cards modeled on the homepage pillars.
     Image on top, name + tagline + arrow CTA below. Active card has a
     strong teal accent so the current selection is unmistakable. */
  .program-cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
    margin-bottom: 2.5rem;
  }

  .program-card {
    display: flex;
    flex-direction: column;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s;
  }

  .program-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
    border-color: var(--huji-teal-light);
    text-decoration: none;
  }

  .program-card:hover .arrow {
    transform: translateX(3px);
  }

  .card-img {
    aspect-ratio: 4/3;
    background-size: cover;
    background-position: center;
    background-color: var(--bg-secondary);
  }

  .card-content {
    padding: 1rem 1.1rem 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    flex: 1;
  }

  .card-name {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-primary);
    line-height: 1.3;
  }

  .card-tagline {
    font-size: 0.82rem;
    color: var(--text-secondary);
    line-height: 1.55;
    flex: 1;
  }

  .card-cta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 0.5rem;
    padding-top: 0.6rem;
    border-top: 1px solid var(--border-light);
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--text-muted);
  }

  .arrow {
    color: var(--text-muted);
    transition: transform 0.15s;
  }

  /* Active state — current program. Strong teal accent on every visible edge. */
  .card-active {
    border-color: var(--huji-teal);
    box-shadow: 0 0 0 1px var(--huji-teal), var(--shadow-md);
  }

  .card-active .card-name { color: var(--huji-teal-dark); }
  .card-active .card-cta { color: var(--huji-teal); }
  .card-active .arrow { color: var(--huji-teal); }
  .card-active .cta-label::before {
    content: "● ";
    color: var(--huji-teal);
    font-size: 0.7em;
    margin-inline-end: 0.15rem;
  }
  .card-active .cta-label { color: var(--huji-teal); }

  /* Tabbed panels: only the targeted one is shown.
     The first panel shows by default when nothing is targeted. */
  .panel { display: none; }
  .panel:target { display: block; }
  .panel-default { display: block; }
  .panels:has(.panel:target) .panel-default:not(:target) { display: none; }

  /* Smooth scroll into view but don't fly past the sticky header. */
  .panel { scroll-margin-top: 2rem; }

  .panel-header {
    margin-bottom: 1.75rem;
  }

  .panel-eyebrow {
    font-size: 0.78rem;
    color: var(--huji-teal);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-bottom: 0.5rem;
  }

  .panel-faculty {
    color: var(--text-muted);
    font-weight: 500;
    text-transform: none;
    letter-spacing: 0;
  }

  .panel-header h2 {
    font-size: 1.65rem;
    font-weight: 700;
    line-height: 1.25;
    margin-bottom: 0.5rem;
  }

  .panel-tagline {
    font-size: 1rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .panel-body {
    max-width: 760px;
    color: var(--text-primary);
  }

  .panel-body :global(h2) {
    font-size: 1.2rem;
    font-weight: 700;
    margin-top: 1.75rem;
    margin-bottom: 0.6rem;
    color: var(--text-primary);
  }

  .panel-body :global(p) {
    font-size: 0.95rem;
    color: var(--text-secondary);
    line-height: 1.8;
    margin-bottom: 0.9rem;
  }

  .panel-body :global(strong) { color: var(--text-primary); font-weight: 600; }

  .panel-body :global(blockquote) {
    border-inline-start: 3px solid var(--border);
    background: var(--bg-secondary);
    padding: 0.85rem 1.1rem;
    border-radius: var(--radius);
    margin: 1rem 0;
    font-size: 0.9rem;
    color: var(--text-secondary);
  }

  .panel-footer {
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-light);
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    align-items: center;
  }

  .cta-button {
    display: inline-block;
    padding: 0.65rem 1.4rem;
    background: var(--huji-teal-dark);
    color: #fff;
    border-radius: var(--radius);
    font-weight: 500;
    font-size: 0.9rem;
    transition: background 0.15s;
  }

  .cta-button:hover {
    background: var(--huji-teal);
    text-decoration: none;
  }

  .cta-link {
    font-size: 0.88rem;
    color: var(--huji-teal);
    text-decoration: none;
  }

  .cta-link:hover {
    text-decoration: underline;
  }

  @media (max-width: 900px) {
    .program-cards { grid-template-columns: 1fr; gap: 0.9rem; }
    .card-img { aspect-ratio: 16/9; }
  }

  @media (max-width: 768px) {
    .hero-split { grid-template-columns: 1fr; gap: 1rem; }
    .hero-split h1 { font-size: 1.7rem; }
    .panel-header h2 { font-size: 1.35rem; }
  }
</style>
