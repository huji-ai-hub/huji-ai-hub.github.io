# Copy this file to .env and fill in real values for local runs.
# In production these come from GitHub repo secrets — do NOT commit a real .env.

# Anthropic API key (console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=sk-ant-...

# GitHub Personal Access Token for the bot account.
# In GitHub Actions this is the repo secret BOT_GITHUB_TOKEN.
# Locally, name it whatever you want and pass it in.
GITHUB_TOKEN=ghp_...

# Optional: override the GitHub repo the bot operates on (default: huji-ai-hub/huji-ai-hub.github.io)
# GITHUB_REPO=huji-ai-hub/huji-ai-hub.github.io

# Optional: structured JSON logging instead of plain text
# LOG_FORMAT=json

# Optional: don't actually open a PR; print what would happen
# DRY_RUN=1
